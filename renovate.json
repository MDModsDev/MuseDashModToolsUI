{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "baseBranchPatterns": [
    "dev"
  ],
  "useBaseBranchConfig": "merge",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "nuget"
      ],
      "matchFileNames": [
        "Directory.Packages.props"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchPackageNames": [
        "Autofac",
        "Autofac.Extensions.DependencyInjection"
      ],
      "groupName": "Autofac",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "matchPackageNames": [
        "Avalonia",
        "Avalonia.Desktop",
        "Avalonia.Fonts.Inter",
        "Avalonia.Headless",
        "Semi.Avalonia"
      ],
      "groupName": "Avalonia",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "Microsoft.CodeAnalysis.Analyzers",
        "Microsoft.CodeAnalysis.CSharp"
      ],
      "groupName": "Microsoft.CodeAnalysis"
    },
    {
      "matchPackageNames": [
        "NLog",
        "NLog.Extensions.Logging"
      ],
      "groupName": "NLog"
    },
    {
      "matchPackageNames": [
        "R3",
        "R3Extensions.Avalonia"
      ],
      "groupName": "R3"
    },
    {
      "matchPackageNames": [
        "Refit",
        "Refit.HttpClientFactory"
      ],
      "groupName": "Refit"
    },
    {
      "matchPackageNames": [
        "Roslynator.CodeAnalysis.Analyzers",
        "Roslynator.Analyzers",
        "Roslynator.Formatting.Analyzers"
      ],
      "groupName": "Roslynator"
    },
    {
      "matchPackageNames": [
        "Tmds.DBus.Protocol",
        "Tmds.DBus.Generator"
      ],
      "groupName": "Tmds.DBus"
    },
    {
      "matchPackageNames": [
        "TUnit",
        "TUnit.Mocks",
        "TUnit.Mocks.Http",
        "TUnit.Mocks.Logging"
      ],
      "groupName": "TUnit",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "matchPackageNames": [
        "Irihi.Ursa",
        "Irihi.Ursa.Themes.Semi"
      ],
      "groupName": "Ursa",
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "Meziantou.Analyzer"
      ],
      "schedule": [
        "* * 1 * *"
      ]
    }
  ]
}
